# 复制为 .env 后填写，.env 不会被提交
#
# 当前实现不读取下面两个变量：backend/levels/fetch.py 通过本机 Codex CLI
# 已授权的 Panda Data MCP OAuth 拉取行情，不读取、不导出、不提交任何账号密码。
# 变量名保留在这里，供后续改成直接调 API 时使用。
PANDA_DATA_USERNAME=
PANDA_DATA_PASSWORD=

# 结局页 AI 复盘（尚未实现，见 docs/deepseek-analysis.md）。只在后端读取，绝不放进前端。
DEEPSEEK_API_KEY=
# 模型名以 GET https://api.deepseek.com/models 的返回为准，不要写死在代码里。
DEEPSEEK_MODEL=

# 仅服务端 backend/narrate 使用，不得写入前端或提交真实密钥
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
LLM_FALLBACK_MODEL=deepseek-v4.1-flash
